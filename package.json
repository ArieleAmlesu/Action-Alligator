{
  "name": "action-alligator",
  "description": "Ti ricorda di applicare ciò che hai già imparato.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "web-ext": "10.8.0",
    "wxt": "0.21.5"
  }
}
